{
  "name": "frame-oversized",
  "description": "A frame of exactly 16385 bytes — one past the relay's inbound bound. Every field in it is valid; only the total size is not.",
  "frame_type": "chat.send",
  "direction": "c2r",
  "receiver": "relay",
  "expect": {
    "result": "reject",
    "error_code": "message_too_large",
    "rule": "V2",
    "close": true
  },
  "wire": {
    "kind": "text",
    "raw": "{\"v\":0,\"type\":\"chat.send\",\"request_id\":\"3f2a7c1e-9b4d-4e28-8a51-6c0d2e7f9b13\",\"payload\":{\"message_id\":\"9c1e5a20-4b7d-4f61-b8e3-2d5a7c0f1846\",\"text\":\"hi\",\"x\":\"\"}}"
  },
  "notes": "Padding lives in an UNKNOWN payload field, which §3 requires be ignored, so V2 (size) is the only rule that can fire. Exact bytes matter, so this vector uses wire.raw rather than wire.json."
}
